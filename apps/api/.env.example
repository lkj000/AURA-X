# Required — set in Railway API service environment variables

# Server
NODE_ENV=production
PORT_API=3003

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth
JWT_SECRET=your-jwt-secret

# Redis (BullMQ)
REDIS_URL=redis://your-redis-host:port

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=https://fearless-presence-production-2d81.up.railway.app,https://app.okovanggo.ai

# External services
REPLICATE_API_TOKEN=your-replicate-token
GIG_API_KEY=aura-x-gig-internal

# Temporal Cloud
TEMPORAL_ADDRESS=your-namespace.tmprl.cloud:7233
TEMPORAL_NAMESPACE=your-namespace
TEMPORAL_TLS_CERT=your-cert
TEMPORAL_TLS_KEY=your-key
